{'matched': True, 'rules': ['.toggle { position: relative; display: inline-flex; flex-shrink: 0; cursor: pointer; align-items: center; }', '.toggle input { position: absolute; inset: 0px; width: 100%; height: 100%; margin: 0px; appearance: none; background: transparent; z-index: 2; cursor: pointer; ', '.toggle-track { width: 42px; height: 24px; border-radius: 999px; background: var(--toggle-off); position: relative; transition: background 0.18s; box-shadow: rg', '.toggle:hover .toggle-track { filter: brightness(0.97); }', '.toggle-track::after { content: ""; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: rgb(255, 255, 255); bord', '.toggle input:checked + .toggle-track { background: var(--accent); }', '.toggle input:checked + .toggle-track::after { transform: translateX(18px); }', '.toggle input:focus-visible + .toggle-track { outline: 2px solid var(--accent); outline-offset: 2px; }']}
